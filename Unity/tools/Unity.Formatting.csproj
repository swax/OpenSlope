<Project Sdk="Microsoft.NET.Sdk">
  <!-- Formatting workspace only: no Unity/VRChat/Basis references, package restore, or build needed.
       Folder mode would skip the many sources wrapped in #if UNITY_EDITOR. The runner loads this
       project twice so both sides of UNITY_6000_0_OR_NEWER are formatted, including opt-in diagnostics. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <DefineConstants>UNITY_EDITOR;OPENSLOPE_RELOAD_DIAG;$(OpenSlopeUnityFormatSymbols)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Importer/**/*.cs;../VRC/**/*.cs;../Basis/**/*.cs;diagnostics/**/*.cs"
             Exclude="../**/*.Generated.cs;../**/bin/**;../**/obj/**" />
  </ItemGroup>
</Project>
