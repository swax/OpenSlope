{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "board-sound-index-v1.schema.json",
  "title": "OpenSlope shared board sound index",
  "description": "Terrain-surface to board-audio-family routes recovered locally from the user's boot executable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["Schema", "SourceExecutable", "SurfaceGroups"],
  "properties": {
    "Schema": { "const": "openslope-board-sound-index/v1" },
    "SourceExecutable": { "type": "string", "minLength": 1 },
    "SurfaceGroups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "type": "integer", "minimum": 0, "maximum": 255 }
    }
  }
}
