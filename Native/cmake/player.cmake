foreach(dependency IN ITEMS vulkan-headers volk openxr)
  openslope_dependency(${dependency})
endforeach()
set(VULKAN_HEADERS_ENABLE_TESTS OFF CACHE BOOL "" FORCE)
FetchContent_MakeAvailable(vulkan-headers)
set(VOLK_PULL_IN_VULKAN OFF CACHE BOOL "" FORCE)
FetchContent_MakeAvailable(volk)
target_link_libraries(volk PUBLIC Vulkan::Headers)
if(WIN32)
  target_compile_definitions(volk PUBLIC VK_USE_PLATFORM_WIN32_KHR)
elseif(ANDROID)
  target_compile_definitions(volk PUBLIC VK_USE_PLATFORM_ANDROID_KHR)
endif()

if(OPENSLOPE_BUILD_TESTS AND NOT ANDROID)
  add_executable(openslope_avatar_render_tests tests/avatar_render_tests.cpp)
  target_link_libraries(openslope_avatar_render_tests PRIVATE openslope_graphics)
  add_executable(openslope_render_tests tests/render_tests.cpp)
  target_link_libraries(openslope_render_tests PRIVATE openslope_graphics)
  # Invoked explicitly on a Vulkan-capable host; portable CI need not have a GPU.
endif()
set(BUILD_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_API_LAYERS OFF CACHE BOOL "" FORCE)
set(BUILD_CONFORMANCE_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_SDK_TESTS OFF CACHE BOOL "" FORCE)
set(BUILD_LOADER ON CACHE BOOL "" FORCE)
set(DYNAMIC_LOADER OFF CACHE BOOL "" FORCE)
FetchContent_MakeAvailable(openxr)

if(CMAKE_CROSSCOMPILING)
  set(OPENSLOPE_HOST_SHADER_DIR "" CACHE PATH "Shader headers generated by a native host build")
  if(NOT EXISTS "${OPENSLOPE_HOST_SHADER_DIR}/terrain_vert.hpp" OR NOT EXISTS "${OPENSLOPE_HOST_SHADER_DIR}/terrain_frag.hpp")
    message(FATAL_ERROR "Build the host player first, then pass OPENSLOPE_HOST_SHADER_DIR=<host-build>/generated")
  endif()
  set(shader_include "${OPENSLOPE_HOST_SHADER_DIR}")
else()
  openslope_dependency(glslang)
  set(ENABLE_OPT OFF CACHE BOOL "" FORCE)
  set(ENABLE_HLSL OFF CACHE BOOL "" FORCE)
  set(ENABLE_SPVREMAPPER OFF CACHE BOOL "" FORCE)
  set(GLSLANG_TESTS OFF CACHE BOOL "" FORCE)
  set(GLSLANG_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
  FetchContent_MakeAvailable(glslang)
  find_package(Python3 COMPONENTS Interpreter REQUIRED)
  set(shader_include "${CMAKE_CURRENT_BINARY_DIR}/generated")
  foreach(stage IN ITEMS vert frag)
    add_custom_command(OUTPUT "${shader_include}/terrain_${stage}.hpp"
      COMMAND "$<TARGET_FILE:glslang-standalone>" -V "${CMAKE_CURRENT_SOURCE_DIR}/shaders/terrain.${stage}" -o "${shader_include}/terrain.${stage}.spv"
      COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tools/embed_shader.py" "${shader_include}/terrain.${stage}.spv" "${shader_include}/terrain_${stage}.hpp" "terrain_${stage}"
      DEPENDS glslang-standalone "shaders/terrain.${stage}" tools/embed_shader.py VERBATIM)
  endforeach()
  add_custom_target(openslope_shaders DEPENDS "${shader_include}/terrain_vert.hpp" "${shader_include}/terrain_frag.hpp")
endif()

add_library(openslope_graphics src/vulkan_renderer.cpp src/vulkan_scene.cpp src/openxr_app.cpp src/audio_device.cpp)
target_include_directories(openslope_graphics PUBLIC src PRIVATE "${shader_include}")
target_link_libraries(openslope_graphics PUBLIC openslope_core volk OpenXR::openxr_loader)
target_compile_definitions(openslope_graphics PUBLIC XR_USE_GRAPHICS_API_VULKAN VK_NO_PROTOTYPES)
if(TARGET openslope_shaders)
  add_dependencies(openslope_graphics openslope_shaders)
endif()
if(WIN32)
  target_link_libraries(openslope_graphics PUBLIC winmm)
  target_compile_definitions(openslope_graphics PUBLIC VK_USE_PLATFORM_WIN32_KHR NOMINMAX WIN32_LEAN_AND_MEAN)
  add_executable(openslope_player src/windows_app.cpp)
  target_link_libraries(openslope_player PRIVATE openslope_graphics user32)
elseif(ANDROID)
  target_link_libraries(openslope_graphics PUBLIC aaudio)
  target_compile_definitions(openslope_graphics PUBLIC XR_USE_PLATFORM_ANDROID VK_USE_PLATFORM_ANDROID_KHR)
  add_library(openslope_player SHARED src/android_app.cpp "${ANDROID_NDK}/sources/android/native_app_glue/android_native_app_glue.c")
  target_include_directories(openslope_player PRIVATE "${ANDROID_NDK}/sources/android/native_app_glue")
  target_link_libraries(openslope_player PRIVATE openslope_graphics nlohmann_json::nlohmann_json android log)
else()
  add_executable(openslope_player src/linux_app.cpp)
  target_link_libraries(openslope_player PRIVATE openslope_graphics)
endif()

add_custom_command(TARGET openslope_player POST_BUILD
  COMMAND "${CMAKE_COMMAND}" -E copy_directory "${CMAKE_CURRENT_SOURCE_DIR}/ThirdPartyNotices" "$<TARGET_FILE_DIR:openslope_player>/licenses"
  COMMAND "${CMAKE_COMMAND}" -E copy "${CMAKE_CURRENT_SOURCE_DIR}/LICENSE" "${CMAKE_CURRENT_SOURCE_DIR}/NOTICE" "$<TARGET_FILE_DIR:openslope_player>/licenses"
  VERBATIM)
