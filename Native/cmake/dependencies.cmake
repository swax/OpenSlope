include(FetchContent)
set(OPENSLOPE_ARCHIVE_CACHE "${CMAKE_CURRENT_LIST_DIR}/../../.openslope/native-downloads" CACHE PATH "Optional verified dependency archives")

function(openslope_dependency name)
  if(name STREQUAL "json")
    set(url "https://codeload.github.com/nlohmann/json/zip/refs/tags/v3.12.0")
    set(hash "34660b5e9a407195d55e8da705ed26cc6d175ce5a6b1fb957e701fb4d5b04022")
  elseif(name STREQUAL "vulkan-headers")
    set(url "https://codeload.github.com/KhronosGroup/Vulkan-Headers/zip/refs/tags/v1.4.309")
    set(hash "51cd37049511e0ba24f6ce3c70a4e6557620a33c83945cce9b28560206dfed86")
  elseif(name STREQUAL "volk")
    set(url "https://codeload.github.com/zeux/volk/zip/refs/tags/vulkan-sdk-1.4.309.0")
    set(hash "fce6801b107213b418549ea9081d794adba8f02dbf3bbb19b0e4b3a4a550a388")
  elseif(name STREQUAL "glslang")
    set(url "https://codeload.github.com/KhronosGroup/glslang/zip/refs/tags/15.1.0")
    set(hash "c4cc5083dd198640f3ad9d2014ac9b31433495a57cd3fb2420cd4e8ea8eb4b2b")
  elseif(name STREQUAL "openxr")
    set(url "https://codeload.github.com/KhronosGroup/OpenXR-SDK/zip/refs/tags/release-1.1.53")
    set(hash "9c67c2d158f8b71a19d9d0b1e73043681cc4df6e90d207417a964b8d6aee1766")
  elseif(name STREQUAL "lodepng")
    set(url "https://codeload.github.com/lvandeve/lodepng/zip/ed6fe5825c6a4fbb7f58ab35a4231c7543cd452a")
    set(hash "e3e5a62322b7afd5037d0aaa27188457226ccdaacc1353d0a1efcccd8f87f504")
  elseif(name STREQUAL "stb")
    set(url "https://codeload.github.com/nothings/stb/zip/f0569113c93ad095470c54bf34a17b36646bbbb5")
    set(hash "b62be3009cb9d4b6385bd4854bddf72d8e91f4e19d1347d6cf9589b19f70d45d")
  elseif(name STREQUAL "zstd")
    set(url "https://codeload.github.com/facebook/zstd/zip/refs/tags/v1.5.7")
    set(hash "7897bc5d620580d9b7cd3539c44b59d78f3657d33663fe97a145e07b4ebd69a4")
  else()
    message(FATAL_ERROR "Unknown OpenSlope dependency: ${name}")
  endif()
  if(EXISTS "${OPENSLOPE_ARCHIVE_CACHE}/${name}.zip")
    set(url "${OPENSLOPE_ARCHIVE_CACHE}/${name}.zip")
  endif()
  FetchContent_Declare(${name} URL "${url}" URL_HASH "SHA256=${hash}" DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
endfunction()
