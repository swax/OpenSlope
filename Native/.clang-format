# Formatting for OpenSlope's native C++. Pinned to clang-format 23.1.3; other versions can format
# slightly differently, so install that one: `uv tool install clang-format==23.1.3`.
BasedOnStyle: LLVM
IndentWidth: 4
AccessModifierOffset: -4
ColumnLimit: 120
PointerAlignment: Left
# Keeps lookup tables such as the glyph font one row per case.
AllowShortCaseLabelsOnASingleLine: true
SeparateDefinitionBlocks: Always
# Within each include block: project headers, then <windows.h>, then other angle-bracket headers.
# The Win32 multimedia headers (mmsystem.h, mmreg.h) do not compile without windows.h before them.
IncludeCategories:
  - Regex: '^<windows\.h>$'
    Priority: 2
  - Regex: '^<'
    Priority: 3
  - Regex: '.*'
    Priority: 1
