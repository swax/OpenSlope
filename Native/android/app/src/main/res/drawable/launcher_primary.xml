<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="@color/launcher_disabled" /><corners android:radius="12dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/launcher_accent_hover" /><stroke android:width="3dp" android:color="@color/launcher_ink" /><corners android:radius="12dp" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/launcher_accent_hover" /><stroke android:width="3dp" android:color="@color/launcher_ink" /><corners android:radius="12dp" /></shape></item>
    <item android:state_hovered="true"><shape><solid android:color="@color/launcher_accent_hover" /><stroke android:width="3dp" android:color="@color/launcher_ink" /><corners android:radius="12dp" /></shape></item>
    <item><shape><solid android:color="@color/launcher_accent" /><corners android:radius="12dp" /></shape></item>
</selector>
