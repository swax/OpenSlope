{
  "name": "slopesmith",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "description": "OpenSlope's browser-based editor for authoring and test-riding SSX-style snowboard courses, with portable exports for Unity and PS2.",
  "scripts": {
    "release:package": "node scripts/package-release.mjs",
    "release:test": "python deploy/test_release_manager.py",
    "dev:multiplayer": "node --env-file-if-exists=.env --import tsx scripts/dev-multiplayer.ts --port 0",
    "multiplayer:build": "node scripts/multiplayer.mjs build",
    "multiplayer:serve": "node --env-file-if-exists=.env scripts/multiplayer.mjs serve",
    "multiplayer:generate": "node scripts/multiplayer.mjs generate",
    "multiplayer:check": "node scripts/multiplayer.mjs check",
    "multiplayer:test": "node scripts/multiplayer.mjs test",
    "multiplayer:unit": "node scripts/multiplayer.mjs unit",
    "multiplayer:bench": "node scripts/multiplayer.mjs bench",
    "dev": "node --env-file-if-exists=.env --import tsx scripts/dev.ts --port 0",
    "run:local-server": "node --env-file-if-exists=.env --import tsx scripts/dev-multiplayer.ts --accounts --behind-proxy",
    "run:local-server:ngrok": "tsx scripts/run-ngrok.ts local-server",
    "run:video-bridge:ngrok": "tsx scripts/run-ngrok.ts video-bridge",
    "serve": "tsx src/server/main.ts",
    "start": "node --enable-source-maps dist-server/main.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "build:iso-importer": "node scripts/build-browser-importer.mjs",
    "notices:inventory": "node scripts/update-browser-notice-inventory.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 --cache --cache-strategy content --cache-location temp/eslintcache .",
    "format": "prettier --write \"{src,test,scripts,tools}/**/*.{ts,tsx,mts,cts,js,mjs,cjs,css,html}\" \"*.{ts,tsx,mts,cts,js,mjs,cjs,css,html}\" && node scripts/multiplayer.mjs format",
    "format:check": "prettier --check \"{src,test,scripts,tools}/**/*.{ts,tsx,mts,cts,js,mjs,cjs,css,html}\" \"*.{ts,tsx,mts,cts,js,mjs,cjs,css,html}\" && node scripts/multiplayer.mjs format:check",
    "test": "tsx test/run.ts --tier fast",
    "test:fast": "tsx test/run.ts --tier fast",
    "test:integration": "tsx test/run.ts --tier integration",
    "test:full": "tsx test/run.ts --tier full",
    "test:node": "tsx test/run.ts --tier full --environment non-browser",
    "test:dom": "tsx test/run.ts --tier full --environment dom",
    "test:api": "tsx test/run.ts --tier full --environment api",
    "test:browser": "tsx test/run.ts --tier full --environment browser --browser-smoke --jobs 1",
    "test:browser:full": "tsx test/run.ts --tier full --environment browser --jobs 2",
    "check": "npm run typecheck && npm run lint && npm run test:fast",
    "check:smoke": "npm run check && npm run test:browser",
    "test:ci": "npm run test:full",
    "test:local": "tsx test/run.ts --tier full --local",
    "coverage": "c8 npm run test:node && npm run coverage:summary",
    "coverage:summary": "node scripts/coverage-summary.mjs",
    "coverage:summary:ci": "node scripts/coverage-summary.mjs --allow-missing",
    "smoke": "tsx scripts/smoke.ts",
    "autotest:map": "tsx scripts/auto-test-map.ts",
    "autotest:play": "tsx scripts/autotest-play-suite.ts",
    "run:course": "tsx scripts/ai-course-run.ts",
    "run:mountain": "tsx scripts/ai-mountain-run.ts",
    "export:project": "tsx scripts/export-project.ts",
    "import:mod-map": "tsx scripts/import-mod-map.ts",
    "backfill:origins": "tsx scripts/backfill-map-origins.ts",
    "budget": "tsx tools/prop-budget.ts",
    "measure:models": "tsx tools/prop-recipes/measure-models.ts",
    "benchmark:retopology": "tsx tools/retopology/benchmark.ts",
    "benchmark:retopology-maps": "tsx tools/retopology/reference-maps.ts",
    "benchmark:retopology-integrate": "tsx tools/retopology/integrate.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "lil-gui": "^0.21.0",
    "livekit-client": "^2.22.4",
    "livekit-server-sdk": "^2.19.1",
    "three": "0.186.1",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/node": "^24.13.3",
    "@types/three": "0.186.0",
    "ajv": "^8.20.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "17.13.0",
    "happy-dom": "^21.0.4",
    "playwright-core": "^1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-java": "2.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
