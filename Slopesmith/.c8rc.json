{
  "all": true,
  "src": ["src"],
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.d.ts",
    "src/**/*.generated.ts"
  ],
  "exclude-after-remap": true,
  "extension": [".ts"],
  "reporter": [
    "text-summary",
    "json-summary",
    "html",
    "lcov"
  ],
  "reports-dir": "coverage",
  "temp-directory": ".coverage-tmp",
  "clean": true
}
