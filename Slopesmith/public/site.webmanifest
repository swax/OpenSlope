{
  "name": "Slopesmith",
  "short_name": "Slopesmith",
  "description": "Author and test-ride SSX-style snowboard courses in your browser with OpenSlope.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#16202c",
  "theme_color": "#0c141d",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/slopesmith_icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
