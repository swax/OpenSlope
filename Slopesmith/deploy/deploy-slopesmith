#!/usr/bin/env bash
set -euo pipefail

readonly RELEASES='/opt/slopesmith/releases'
readonly CURRENT='/opt/slopesmith/current'
readonly NODE_BIN='/opt/node24/bin'
readonly SERVICE='slopesmith.service'
readonly UPDATE_CONFIG='/etc/slopesmith-update.env'

usage() {
  echo 'usage: sudo deploy-slopesmith <40-character commit on the configured repository main branch>'
}

if [[ ${1:-} == '--help' ]]; then
  usage
  exit 0
fi
if [[ $# -ne 1 || ! $1 =~ ^[0-9a-f]{40}$ ]]; then
  usage >&2
  exit 64
fi
readonly REVISION="$1"
readonly RELEASE="$RELEASES/$REVISION"

if [[ $(id -u) -ne 0 ]]; then
  echo 'deploy-slopesmith must be run through sudo' >&2
  exit 77
fi

# Direct operator deployments and browser-queued deployments use the same root-owned source. Keeping the URL
# out of argv also prevents the web process from turning this helper into a general-purpose root-side clone.
if [[ -e "$UPDATE_CONFIG" ]]; then
  if [[ ! -f "$UPDATE_CONFIG" || -L "$UPDATE_CONFIG" || $(stat -c '%U' "$UPDATE_CONFIG") != 'root' ]]; then
    echo "$UPDATE_CONFIG must be a root-owned regular file" >&2
    exit 65
  fi
  config_mode=$(stat -c '%a' "$UPDATE_CONFIG")
  if (( (8#$config_mode & 022) != 0 )); then
    echo "$UPDATE_CONFIG must not be writable by its group or by other users" >&2
    exit 65
  fi
  # shellcheck disable=SC1091 -- fixed, root-owned machine configuration validated immediately above.
  source "$UPDATE_CONFIG"
fi
readonly REPO_URL="${SLOPESMITH_UPDATE_REPOSITORY:-https://github.com/swax/OpenSlope.git}"
# Unprivileged account that clones, installs and builds a release. Its home supplies the Git credentials.
readonly BUILD_USER="${SLOPESMITH_BUILD_USER:-slopesmith-build}"
readonly BUILD_HOME="${SLOPESMITH_BUILD_HOME:-/home/$BUILD_USER}"
if [[ -z "$REPO_URL" || "$REPO_URL" == -* || "$REPO_URL" == *$'\n'* || "$REPO_URL" == *$'\r'*
      || "$REPO_URL" =~ ^https?://[^/]*@ ]]; then
  echo 'SLOPESMITH_UPDATE_REPOSITORY is invalid' >&2
  exit 65
fi

exec 9>/run/lock/slopesmith-deploy.lock
if ! flock -n 9; then
  echo 'another Slopesmith deployment is already running' >&2
  exit 75
fi

stage=''
cleanup() {
  if [[ -n "$stage" && "$stage" == /var/tmp/slopesmith-deploy.* && -d "$stage" ]]; then
    rm -rf -- "$stage"
  fi
}
trap cleanup EXIT

as_build_user() {
  runuser -u "$BUILD_USER" -- env \
    HOME="$BUILD_HOME" \
    PATH="$NODE_BIN:/usr/local/bin:/usr/bin:/bin" \
    "$@"
}

as_build_user_in_app() {
  local app="$1"
  shift
  runuser -u "$BUILD_USER" -- env \
    HOME="$BUILD_HOME" \
    PATH="$NODE_BIN:/usr/local/bin:/usr/bin:/bin" \
    /bin/bash -c 'cd "$1"; shift; exec "$@"' bash "$app" "$@"
}

run_ts_test() {
  local app="$1" test_file="$2"
  as_build_user_in_app "$app" "$app/node_modules/.bin/tsx" "$test_file"
}

validate_tree() {
  local tree="$1" link resolved
  if find "$tree" -xdev ! -type f ! -type d ! -type l -print -quit | grep -q .; then
    echo 'release contains an unsupported special file' >&2
    exit 65
  fi
  while IFS= read -r -d '' link; do
    if [[ $(readlink "$link") == /* ]]; then
      echo "release contains an absolute symlink: $link" >&2
      exit 65
    fi
    resolved=$(realpath -m -- "$(dirname "$link")/$(readlink "$link")")
    case "$resolved" in
      "$tree"/*) ;;
      *) echo "release contains an escaping symlink: $link" >&2; exit 65 ;;
    esac
  done < <(find "$tree" -xdev -type l -print0)
}

if [[ ! -e "$RELEASE" ]]; then
  stage=$(mktemp -d /var/tmp/slopesmith-deploy.XXXXXXXXXX)
  chown "$BUILD_USER:$BUILD_USER" "$stage"

  echo '[deploy] cloning the configured repository'
  as_build_user git clone --filter=blob:none --no-checkout --quiet -- "$REPO_URL" "$stage/repo"
  as_build_user git -C "$stage/repo" cat-file -e "$REVISION^{commit}"
  if ! as_build_user git -C "$stage/repo" merge-base --is-ancestor "$REVISION" refs/remotes/origin/main; then
    echo "$REVISION is not reachable from the configured repository main branch" >&2
    exit 65
  fi
  as_build_user git -C "$stage/repo" checkout --detach --quiet "$REVISION"
  [[ $(as_build_user git -C "$stage/repo" rev-parse HEAD) == "$REVISION" ]]

  readonly APP="$stage/repo/Slopesmith"
  [[ -d "$APP" && ! -L "$APP" ]]
  [[ $(realpath "$APP") == "$stage/repo/Slopesmith" ]]
  # Production releases intentionally contain no .git directory. Stamp the exact source revision into the
  # immutable app tree so Settings can still say what the running process loaded.
  printf '%s\n' "$REVISION" > "$APP/.slopesmith-revision"

  echo "[deploy] installing pinned dependencies as $BUILD_USER"
  as_build_user "$NODE_BIN/npm" --prefix "$APP" ci --no-audit
  echo "[deploy] running release gates as $BUILD_USER"
  as_build_user "$NODE_BIN/npm" --prefix "$APP" run typecheck
  run_ts_test "$APP" test/response-cache.test.ts
  run_ts_test "$APP" test/props-payload-cache.test.ts
  run_ts_test "$APP" test/worker-pool.test.ts
  run_ts_test "$APP" test/accounts.test.ts
  run_ts_test "$APP" test/transport-guards.test.ts

  # This real-socket suite has one historically timing-sensitive snapshot assertion. Keep the narrow waiver
  # until it stops reproducing under a saturated shared-CPU host; any other failure still blocks activation.
  session_log="$stage/session-test.log"
  set +e
  run_ts_test "$APP" test/sessions.test.ts 2>&1 | tee "$session_log"
  session_status=${PIPESTATUS[0]}
  set -e
  if [[ $session_status -ne 0 ]]; then
    failure_count=$(grep -c '^FAIL ' "$session_log" || true)
    if [[ $failure_count -ne 1 ]] || ! grep -Fxq \
      'FAIL the room writes what it holds as an ordinary revision, carrying the work of both tabs' \
      "$session_log"; then
      echo '[deploy] session suite has a new or unexpected failure' >&2
      exit "$session_status"
    fi
    echo '[deploy] waived the sole session snapshot timing failure'
  fi
  run_ts_test "$APP" test/chat.test.ts
  run_ts_test "$APP" test/sync.test.ts
  run_ts_test "$APP" test/voice.test.ts
  run_ts_test "$APP" test/voice-proxy.test.ts
  as_build_user "$NODE_BIN/npm" --prefix "$APP" run build
  as_build_user "$NODE_BIN/npm" --prefix "$APP" prune --omit=dev --no-audit

  validate_tree "$APP"
  install -d -o root -g root -m 0755 "$RELEASES"
  readonly INSTALLING="$RELEASES/.installing-$REVISION"
  [[ ! -e "$INSTALLING" ]]
  mv -- "$APP" "$INSTALLING"
  chown -R root:root "$INSTALLING"
  chmod -R go-w "$INSTALLING"
  mv -- "$INSTALLING" "$RELEASE"
else
  [[ -d "$RELEASE" && ! -L "$RELEASE" ]]
  [[ $(stat -c '%U:%G' "$RELEASE") == 'root:root' ]]
  echo "[deploy] reusing installed release $REVISION"
fi

echo '[deploy] validating packaged server entry as slopesmith'
runuser -u slopesmith -- env \
  NODE_ENV=production \
  SLOPESMITH_APP_ROOT="$RELEASE" \
  SLOPESMITH_WORKSPACE_ROOT=/srv/slopesmith/workspace \
  SLOPESMITH_MAPS_ROOT=/srv/slopesmith/maps \
  "$NODE_BIN/node" --enable-source-maps "$RELEASE/dist-server/main.js" help >/dev/null

previous=$(readlink -f "$CURRENT")
if [[ "$previous" == "$RELEASE" ]]; then
  echo "[deploy] $REVISION is already active"
  exit 0
fi
case "$previous" in
  "$RELEASES"/*) ;;
  *) echo "current release resolves outside $RELEASES: $previous" >&2; exit 65 ;;
esac

switch_current() {
  local target="$1" link="$CURRENT.new.$$"
  ln -s -- "$target" "$link"
  mv -Tf -- "$link" "$CURRENT"
}

rollback() {
  echo "[deploy] activation failed; rolling back to $previous" >&2
  systemctl stop "$SERVICE" || true
  switch_current "$previous"
  systemctl start "$SERVICE"
}

echo "[deploy] stopping $SERVICE"
systemctl stop "$SERVICE"
switch_current "$RELEASE"
echo "[deploy] starting $SERVICE"
if ! systemctl start "$SERVICE"; then
  rollback
  exit 1
fi

ready=0
for _ in $(seq 1 30); do
  code=$(curl -sS -o /dev/null -w '%{http_code}' http://127.0.0.1:5180/api/auth/session || true)
  if [[ "$code" == 200 || "$code" == 401 ]]; then
    ready=1
    break
  fi
  sleep 1
done
if [[ $ready -ne 1 ]] || ! systemctl is-active --quiet "$SERVICE"; then
  rollback
  exit 1
fi

echo "[deploy] active release: $REVISION"
