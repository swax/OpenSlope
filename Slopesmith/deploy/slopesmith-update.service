# repo-hygiene: allow[config-listing] -- project-authored systemd service unit, not retail configuration
[Unit]
Description=Install a queued Slopesmith revision
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/slopesmith-update-runner
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/slopesmith /var/lib/slopesmith-update
