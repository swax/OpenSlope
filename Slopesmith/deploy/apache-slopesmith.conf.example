# repo-hygiene: allow[config-listing] -- project-authored Apache virtual host, not retail configuration
# Replace slopesmith.example.com and obtain the named certificate before enabling this site.
<VirtualHost *:80>
    ServerName slopesmith.example.com
    DocumentRoot /opt/slopesmith/current/dist

    <Directory /opt/slopesmith/current/dist>
        Options -Indexes
        AllowOverride None
        Require all granted
    </Directory>

    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^ https://slopesmith.example.com%{REQUEST_URI} [END,NE,R=permanent]
</VirtualHost>

<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName slopesmith.example.com
    DocumentRoot /opt/slopesmith/current/dist
    Protocols h2 http/1.1

    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"
    # Drop any X-Forwarded-For the client sent, so the entry mod_proxy appends is the client address the API's
    # login rate limiter counts (it reads the last entry) rather than one the client chose.
    RequestHeader unset X-Forwarded-For
    ProxyPass /api/ http://127.0.0.1:5180/api/ upgrade=websocket retry=0
    ProxyPassReverse /api/ http://127.0.0.1:5180/api/

    <Directory /opt/slopesmith/current/dist>
        Options -Indexes
        AllowOverride None
        Require all granted
        FallbackResource /index.html
        Header set Cache-Control "no-cache"
    </Directory>

    <Location /assets/>
        Header set Cache-Control "public, max-age=31536000, immutable"
    </Location>

    # Every URL the client emits here carries the GLB's SHA-256 as ?v=..., so a changed model has a new
    # cache key even though its readable path stays stable.
    <Location /characters/>
        Header set Cache-Control "public, max-age=31536000, immutable"
    </Location>

    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set X-Frame-Options "SAMEORIGIN"

    ErrorLog ${APACHE_LOG_DIR}/slopesmith-error.log
    # LiveKit signaling carries a short-lived token in the query string. Apache's standard `combined` format
    # uses %r and would retain it; %U records only the path and deliberately omits the query.
    LogFormat "%h %l %u %t \"%m %U %H\" %>s %b \"%{Referer}i\" \"%{User-Agent}i\"" slopesmith_no_query
    CustomLog ${APACHE_LOG_DIR}/slopesmith-access.log slopesmith_no_query

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/slopesmith.example.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/slopesmith.example.com/privkey.pem
    Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
</IfModule>
