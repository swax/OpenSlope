SLOPESMITH_APP_ROOT=/opt/slopesmith/current
SLOPESMITH_WORKSPACE_ROOT=/srv/slopesmith/workspace
SLOPESMITH_MAPS_ROOT=/srv/slopesmith/maps
SLOPESMITH_METRICS_INTERVAL_MS=60000
SLOPESMITH_SLOW_REQUEST_MS=1000
# How much the service says in the journal: debug, info, warn or error. Read once, at start.
SLOPESMITH_LOG_LEVEL=info
# One JSON object per line, for a log collector. Unset, each line is text a person reads.
# SLOPESMITH_LOG_FORMAT=json
# Public DNS authorities accepted from the TLS proxy's Host/X-Forwarded-Host. Replace this example; the API
# rejects every unlisted DNS name even when its Origin matches, while loopback and literal IPs need no entry.
SLOPESMITH_ALLOWED_HOSTS=slopesmith.example.com
HOST=127.0.0.1
PORT=5180

# Optional voice chat. Keep the API key and secret in a separate root-owned environment file in production;
# deploy/install-livekit.sh creates one and adds it to the systemd service automatically.
# SLOPESMITH_LIVEKIT_URL=wss://slopesmith.example.com/api/livekit
# SLOPESMITH_LIVEKIT_API_KEY=replace-with-random-api-key
# SLOPESMITH_LIVEKIT_API_SECRET=replace-with-random-api-secret
# SLOPESMITH_LIVEKIT_ROOM=slopesmith-prod
# SLOPESMITH_LIVEKIT_UPSTREAM=http://127.0.0.1:7880

# Ordinarily leave these unset. On a 2-vCPU host the defaults are one reference worker and one document
# worker; larger hosts divide one shared host budget while retaining a separate document worker.
# SLOPESMITH_REFERENCE_WORKERS=1
# SLOPESMITH_DOCUMENT_WORKERS=1
