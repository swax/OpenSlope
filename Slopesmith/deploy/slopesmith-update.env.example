# The repository whose main branch Settings checks and the privileged updater is allowed to install.
# Point this at your fork to keep a forked Slopesmith deployment on that fork. Do not put credentials in
# the URL: the unprivileged build account's Git credential/SSH configuration supplies private access.
SLOPESMITH_UPDATE_REPOSITORY=https://github.com/swax/OpenSlope.git

# The unprivileged account that clones, installs dependencies, and builds candidates. Its protected home
# supplies Git credentials. It never owns the installed release or the Slopesmith service's durable data.
SLOPESMITH_BUILD_USER=slopesmith-build
SLOPESMITH_BUILD_HOME=/home/slopesmith-build
