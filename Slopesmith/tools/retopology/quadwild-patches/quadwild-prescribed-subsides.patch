+/// Prescribed subside subdivision: v0/v1 are the subside's endpoint mesh vertex ids and vMid is
+/// any interior polyline vertex id (-1 for a single-edge subside). fractions optionally carries
+/// count-1 strictly increasing arc-length split positions in (0, 1) measured from v0, placing the
+/// generated boundary vertices instead of the default uniform-in-arc spacing.
+struct FixedSubside
+{
+    long long v0 = -1;
+    long long v1 = -1;
+    long long vMid = -1;
+    int count = 0;
+    std::vector<double> fractions;
+};
+/// Optional prescribed subside subdivisions; one line per record, "v0 v1 vMid count [f1 ... fn]".
+/// Returns empty if the file does not exist.
+std::vector<FixedSubside> loadFixedSubsides(const std::string& filename);
 
