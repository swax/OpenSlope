+    //PIN PRESCRIBED RIMS THROUGH SMOOTHING
+    //The smoother slides boundary vertices along their feature curves, which would undo the
+    //sidecar's prescribed boundary placement. Every quadmesh boundary loop hosting a prescribed
+    //subside (seeded by the records' endpoint positions) is restored after the smooth.
+    std::vector<std::pair<size_t, PolyMesh::CoordType>> pinnedRimVertices;
+    if (!trimeshFixedSubsides.empty())
+    {
+        std::map<std::pair<size_t, size_t>, int> quadEdgeUse;
+        for (size_t fId = 0; fId < quadmesh.face.size(); fId++)
+        {
+            const int corners = quadmesh.face[fId].VN();
+            for (int k = 0; k < corners; k++)
+            {
+                const size_t a = vcg::tri::Index(quadmesh, quadmesh.face[fId].V(k));
+                const size_t b = vcg::tri::Index(quadmesh, quadmesh.face[fId].V((k + 1) % corners));
+                quadEdgeUse[{std::min(a, b), std::max(a, b)}]++;
+            }
+        }
+        std::map<size_t, std::vector<size_t>> boundaryAdjacency;
+        for (const auto& edge : quadEdgeUse)
+        {
+            if (edge.second != 1)
+                continue;
+            boundaryAdjacency[edge.first.first].push_back(edge.first.second);
+            boundaryAdjacency[edge.first.second].push_back(edge.first.first);
+        }
+        std::vector<PolyMesh::CoordType> seeds;
+        for (const auto& fixedSubside : trimeshFixedSubsides)
+        {
+            for (const long long vId : {fixedSubside.v0, fixedSubside.v1})
+            {
+                const auto& p = trimesh.vert[vId].P();
+                seeds.push_back(PolyMesh::CoordType(p.X(), p.Y(), p.Z()));
+            }
+        }
+        const double seedEpsilon = 0.1;
+        std::set<size_t> visited;
+        for (const auto& entry : boundaryAdjacency)
+        {
+            if (visited.count(entry.first))
+                continue;
+            std::vector<size_t> loop;
+            std::vector<size_t> stack{entry.first};
+            visited.insert(entry.first);
+            while (!stack.empty())
+            {
+                const size_t at = stack.back();
+                stack.pop_back();
+                loop.push_back(at);
+                for (const size_t next : boundaryAdjacency[at])
+                    if (visited.insert(next).second)
+                        stack.push_back(next);
+            }
+            bool prescribed = false;
+            for (size_t lId = 0; lId < loop.size() && !prescribed; lId++)
+                for (size_t sId = 0; sId < seeds.size() && !prescribed; sId++)
+                    prescribed = (quadmesh.vert[loop[lId]].P() - seeds[sId]).Norm() < seedEpsilon;
+            if (prescribed)
+                for (const size_t vId : loop)
+                    pinnedRimVertices.push_back({vId, quadmesh.vert[vId].P()});
+        }
+        if (!pinnedRimVertices.empty())
+            std::cout<<"pinning "<<pinnedRimVertices.size()<<" prescribed rim vertices through smoothing"<<std::endl;
+    }
