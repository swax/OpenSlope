+std::vector<FixedSubside> loadFixedSubsides(const std::string& filename)
+{
+    std::vector<FixedSubside> fixedSubsides;
+
+    std::ifstream input;
+    input.open(filename.c_str());
+    if (!input.is_open())
+    {
+        //Optional file: absent means no prescribed subdivisions
+        return fixedSubsides;
+    }
+
+    size_t numFixed = 0;
+    std::string line;
+    if (!std::getline(input, line) || !(std::istringstream(line) >> numFixed))
+    {
+        std::cout<<"ERROR LOADING FIXED SUBSIDES FILE"<<std::endl;
+        exit(0);
+    }
+    fixedSubsides.reserve(numFixed);
+    while (fixedSubsides.size() < numFixed && std::getline(input, line))
+    {
+        if (line.find_first_not_of(" \t\r") == std::string::npos)
+            continue;
+        std::istringstream record(line);
+        FixedSubside fixed;
+        if (!(record >> fixed.v0 >> fixed.v1 >> fixed.vMid >> fixed.count))
+        {
+            std::cout<<"ERROR LOADING FIXED SUBSIDES FILE"<<std::endl;
+            exit(0);
+        }
+        if (fixed.count < 1)
+        {
+            std::cout<<"ERROR: FIXED SUBSIDE COUNT MUST BE >= 1"<<std::endl;
+            exit(0);
+        }
+        //Optional per-subside split fractions: exactly count-1, strictly increasing in (0, 1)
+        double fraction;
+        while (record >> fraction)
+            fixed.fractions.push_back(fraction);
+        if (!fixed.fractions.empty())
+        {
+            if (fixed.fractions.size() != static_cast<size_t>(fixed.count) - 1)
+            {
+                std::cout<<"ERROR: FIXED SUBSIDE HAS "<<fixed.fractions.size()
+                        <<" FRACTIONS FOR COUNT "<<fixed.count<<std::endl;
+                exit(0);
+            }
+            for (size_t k = 0; k < fixed.fractions.size(); k++)
+            {
+                const double previous = k == 0 ? 0.0 : fixed.fractions[k - 1];
+                if (fixed.fractions[k] <= previous || fixed.fractions[k] >= 1.0)
+                {
+                    std::cout<<"ERROR: FIXED SUBSIDE FRACTIONS MUST BE STRICTLY INCREASING IN (0, 1)"<<std::endl;
+                    exit(0);
+                }
+            }
+        }
+        fixedSubsides.push_back(fixed);
+    }
+    if (fixedSubsides.size() != numFixed)
+    {
+        std::cout<<"ERROR LOADING FIXED SUBSIDES FILE"<<std::endl;
+        exit(0);
+    }
+    input.close();
+
+    return fixedSubsides;
+}
