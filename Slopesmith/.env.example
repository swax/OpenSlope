# DNS authorities accepted by both Vite and the separately reachable API when the editor uses a tunnel.
# No scheme or path; an optional port pins that name to one authority. Literal IPs and loopback need no entry.
SLOPESMITH_ALLOWED_HOSTS=your-editor-domain.ngrok.app

# Two distinct HTTPS endpoint URLs used by the `npm run run:*:ngrok` commands. The editor endpoint exposes
# Slopesmith on port 5179; the video endpoint exposes Yattee on port 8085 for Quest/mobile browsers that cannot
# reach the workstation's loopback interface. If Slopesmith is already hosted, only the video endpoint is needed.
SLOPESMITH_LOCAL_SERVER_NGROK_URL=https://your-editor-domain.ngrok.app
SLOPESMITH_VIDEO_BRIDGE_NGROK_URL=https://your-video-domain.ngrok.app

# Optional on a developer/local server: compare Settings → Server against this fork's main branch instead of
# the checkout's origin. Production automatic updates use the root-owned /etc/slopesmith-update.env instead.
# SLOPESMITH_UPDATE_REPOSITORY=https://github.com/your-account/OpenSlope.git
