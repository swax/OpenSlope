# Coding-agent configuration is local. The tracked Slopesmith verification skill remains project
# documentation for the workflow described in Slopesmith/docs/029-agent-layer.md.
.codex/
.claude/

# Build output
bin/
obj/
# dotnet test --collect:"XPlat Code Coverage" drops a per-run cobertura report here.
TestResults/
Slopesmith/coverage/
Slopesmith/.coverage-tmp/

# Local course content
Slopesmith/courses/

# Local authoring fixtures and generated demo output.
Unity/Alpha/
Unity/docs/authoring/demo/
# Staged map data (Maps/<MAP> + Maps/Shared), staged by `snowknife unity` into a project's Assets/.
Unity/Maps/

Blender/*Tower*/

# Repo-root staging intermediate that `snowknife import`/`gltf` write (diagnosable raw OBJ/JSON + gltf/),
# alongside Overrides/ — the hand-authored prop remodel packages `snowknife overrides` installs.
# Root-anchored: Slopesmith's own Maps/ spellings are ignored by Slopesmith/.gitignore.
Maps/*

# Research scratch — regenerated ELF symbol map and the analysis DB it's derived from.
elf-map.md
analysis.sqlite

# Executable bytes a snowknife patch replaced, saved beside the ISO they came from so --revert can
# restore it. Derived from the user's own disc, specific to one image, and never redistributable.
*.snowknife-restore.json

# IDE
.vs/
*.user

# Python scratch
__pycache__/
*.py[cod]

# Scratch: probe output, study renders, benchmark job directories. Regenerated by whichever script
# wrote it, and some of it is plotted from a retail level's own geometry.
temp/

# Optional local QuadWild-BiMDF checkout. It is a separate GPL repository with
# non-redistributable optional dependencies, so keep it durable but unvendored.
/quadwild-bimdf/
Blender/blender_mcp_addon.py

# Durable local evidence moved out of disposable temp/. Contents are machine-local and may include
# large emulator captures or derived retail data; only the inventory README is versioned.
ResearchData/*
!ResearchData/README.md

# Disc images. Anything extracted from a disc is derived from the owner's own copy of the game:
# theirs to use, not theirs to redistribute, and never something a commit should carry. The
# extension rule is defence in depth for an image saved outside discs/; the hygiene gate's
# unclassified-file rule remains the backstop for any format neither rule names.
discs/
*.iso

# Optional local integration fixtures.
ice-cream-social/

# Generic local/generated data directories. These two reviewed interoperability
# contracts are source inputs and must remain available in a fresh checkout.
data/
!Trailmap/specs/data/
!Trailmap/specs/data/ride-v1.json
!Trailmap/specs/data/external-sound-banks-v1.json

# Prop-recipe scratch: generated atlas pages, preview renders, and upscales. Recipes rebuild these
# outputs, and tracked GLBs embed their required atlases.
Slopesmith/tools/prop-recipes/build/
# Blender preview and editing workspaces. Tracked GLBs rebuild from checked-in recipes or source code;
# .blend files also embed machine-local configuration and paths.
Slopesmith/tools/character-models/stick-figure-rigged.blend
Slopesmith/tools/prop-recipes/props/props.blend

# Texture-recipe output and previews. Recipes rebuild these byte-identically, so generated PNGs stay local.
Slopesmith/tools/texture-recipes/build/
